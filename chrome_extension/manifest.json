{
  "manifest_version": 3,
  "name": "AGP Cockpit Bridge",
  "version": "0.3.27",
  "description": "Experimental automated bridge between ChatGPT and AGP Cockpit.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "debugger",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:9876/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "build_identity.js",
        "protocol_action_contract_v1.js",
        "transport_protocol_v1.js",
        "conversation_contract.js",
        "protocol_canonicalizer_v1.js",
        "phase7_single_round.js",
        "phase8_multi_round.js",
        "native_message_evidence.js",
        "browser_native_transport.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
