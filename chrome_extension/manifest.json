{
  "manifest_version": 3,
  "name": "AGP Cockpit Bridge",
  "version": "0.3.0",
  "description": "Experimental automated bridge between ChatGPT and AGP Cockpit.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
