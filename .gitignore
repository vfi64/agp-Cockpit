# Local maintainer execution history; the canonical runner is versioned.
/Download/
!/Download/
/Download/*
!/Download/run_next.py

# Local runtime/bootstrap evidence.
/.local/

# Python local environments and caches.
/.venv/
__pycache__/
*.py[cod]
# Build metadata from `pip install -e .`; tracked copies were rewritten by every install and
# blocked the Kit's clean-worktree preflights (Kit 1.1.1 adoption, PR 352).
*.egg-info/

# macOS metadata.
.DS_Store
.agentic/tmp/

# Phase 066 local browser-test artifacts
node_modules/
test-results/
playwright-report/

# Local recovery files created by bounded repair steps
*.bak

# Kit rule acknowledgement: local runtime state, never committed (Kit layout).
# A committed copy is restored by the Kit before push and then mismatches the
# current rule snapshot (snapshot_id_mismatch, 2026-10-04 steps 1650-1652).
/.agentic/rule_ack/
